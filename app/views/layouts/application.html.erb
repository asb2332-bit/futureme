<!DOCTYPE html>
<html lang="en">
<head>
  <title>FutureMe · Account</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/auth.css">
</head>
<body>
  <div class="stripe" aria-hidden="true"></div>
  <main class="app account-shell">
    <nav class="site-nav"><a class="logo" href="/"><span class="mark" aria-hidden="true">FM</span>FutureMe</a>
      <% if current_user %>
        <span class="account-nav"><span><%= current_user.email_address %></span><%= button_to "Log out", logout_path %></span>
      <% end %>
    </nav>
    <% flash.each do |kind, message| %><p role="alert" class="flash"><%= message %></p><% end %>
    <%= yield %>
  </main>
</body>
</html>
